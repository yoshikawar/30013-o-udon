# Main is the Windows PC running Docker Desktop with WSL integration.
NODE_ID=pc-main
SEED=101
APP_DIR=apps/example
# Replace with this PC's wired LAN IPv4 address.
BIND_IP=192.168.10.10
HOST_PORT=39001
CLUSTER_SECRET=replace-with-same-random-secret-on-all-three-pcs
EXPECTED_WORKERS=2
STARTUP_WAIT_MS=60000
JOB_TIMEOUT_MS=10000
APP_READ_TIMEOUT_MS=30000
