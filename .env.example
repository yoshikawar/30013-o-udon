# practice.sh が読む設定。このファイルを .env にコピーして値を書き換える（.env は Git に入らない）
#   cp .env.example .env && chmod 600 .env
# 環境変数がすでに設定されていれば、そちらが優先される

# 公式の試合の token（./practice.sh）
PROCON_TOKEN=
# 練習場の token（./practice.sh --arena）
PROCON_ARENA_TOKEN=
# 公式のサーバーの URL（省略すると http://172.28.0.10:8080）
VENUE_BASE_URL=http://172.28.0.10:8080
